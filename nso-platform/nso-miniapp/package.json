{
  "name": "nso-miniapp",
  "version": "0.0.1",
  "private": true,
  "description": "智慧非标订单打样与变更协同平台微信小程序",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
