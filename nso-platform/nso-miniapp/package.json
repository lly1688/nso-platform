    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@dcloudio/types": "latest",
    "@dcloudio/vite-plugin-uni": "vue3",
    "sass": "^1.83.4",
    "typescript": "^5.7.3",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.0"
  }
}
